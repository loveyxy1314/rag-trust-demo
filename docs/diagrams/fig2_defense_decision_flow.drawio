        </mxCell>
        <mxCell id="in_d" value="&lt;b&gt;Top-5 候选文档&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;doc_id · text · source&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
