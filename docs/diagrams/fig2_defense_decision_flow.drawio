        <mxCell id="s1" value="&lt;b&gt;① SHA-256 校验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;verify(doc, manifest)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.5;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
