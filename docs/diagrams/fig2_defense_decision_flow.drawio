        </mxCell>
        <mxCell id="q_fast" value="直接隔离 / 复核&lt;br&gt;• fail → quarantine&lt;br&gt;• missing → review&lt;br&gt;（跳过 LLM 节省算力）" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="304" width="210" height="74" as="geometry" />
        </mxCell>
        <mxCell id="r_prov" value="转人工复核（review）&lt;br&gt;• distro_wiki（已验证未列）&lt;br&gt;• forum / blog / archive&lt;br&gt;保守策略：不进上下文" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="530" width="210" height="74" as="geometry" />
        </mxCell>
        <mxCell id="cache_d" value="缓存命中？&lt;br&gt;(prompt+text+ref)" style="rhombus;fillColor=#FDF9E7;strokeColor=#D4A017;fontColor=#6B4E00;strokeWidth=1.6;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="672" y="336" width="174" height="72" as="geometry" />
        </mxCell>
        <mxCell id="br1" value="分支 1：行为指令短调用（≤32 tokens）&lt;br&gt;输出 {&amp;quot;label&amp;quot;: attack | unclear | quoted | none}&lt;br&gt;分值：0.90 / 0.55 / 0.25 / 0.02（失败重试 1 次）" style="rounded=1;arcSize=12;fillColor=#FEF3E6;strokeColor=#F28E2B;fontColor=#7A4100;strokeWidth=2.0;fontSize=10.8;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="896" y="326" width="306" height="82" as="geometry" />
        </mxCell>
        <mxCell id="br2" value="分支 2：事实一致性短调用（≤32 tokens）&lt;br&gt;输出 {&amp;quot;label&amp;quot;: contradicted | insufficient | supported}&lt;br&gt;分值：0.85 / 0.50 / 0.05（仅读 text + trusted_ref）" style="rounded=1;arcSize=12;fillColor=#FEF3E6;strokeColor=#F28E2B;fontColor=#7A4100;strokeWidth=2.0;fontSize=10.8;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="896" y="434" width="306" height="82" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="冻结风险聚合：risk_score = max(score_injection, score_fact)&lt;br&gt;解析修复后仍失败则回退 review；结果写入 detector_cache.jsonl" style="rounded=1;arcSize=12;fillColor=#EAF5F4;strokeColor=#76B7B2;fontColor=#1F4E4A;strokeWidth=1.6;fontSize=11.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
