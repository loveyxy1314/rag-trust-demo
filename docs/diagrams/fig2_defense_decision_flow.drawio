        <mxCell id="c_sem" value="层 3：双分支语义检测 (Qwen2.5-1.5B, split-v6, ≤32 tokens, 失败重试 1 次)" style="rounded=1;arcSize=4;fillColor=#FAFAFB;strokeColor=#ADB5BD;fontColor=#495057;strokeWidth=1.1;fontSize=10.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;verticalAlign=top;align=left;spacingTop=5;spacingLeft=9;fontStyle=1;" vertex="1" parent="1">
