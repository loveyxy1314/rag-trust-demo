        <mxCell id="d2" value="&lt;b&gt;白名单?&lt;/b&gt;" style="rhombus;fillColor=#FFFFFF;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.3;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="358" y="166" width="90" height="56" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;缓存命中?&lt;/b&gt;" style="rhombus;fillColor=#FFFFFF;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="564" y="74" width="108" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;分支 1：行为指令判断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;attack(0.90) | unclear(0.55) | quoted(0.25) | none(0.02)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.4;fontSize=10;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="724" y="52" width="276" height="56" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;分支 2：事实一致性（仅读 text + trusted_ref）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;contradicted(0.85) | insufficient(0.50) | supported(0.05)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.4;fontSize=10;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="724" y="126" width="276" height="56" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="&lt;b&gt;风险聚合与写缓存：risk_score = max(s1, s2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;键控：(prompt_ver + text + ref)；修复后仍失败则回退 review&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#2D3748;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="564" y="212" width="436" height="58" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;阈值判定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;0.70 / 0.40&lt;/font&gt;" style="rhombus;fillColor=#FFFFFF;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.3;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="718" y="320" width="128" height="56" as="geometry" />
        </mxCell>
        <mxCell id="allow" value="&lt;b&gt;放行 (allow, risk_score &amp;lt; 0.40)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;拼入 [doc_id] text 数据区；全空则拒答&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.5;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="654" y="412" width="256" height="54" as="geometry" />
        </mxCell>
        <mxCell id="block" value="&lt;b&gt;拦截并排除出生成上下文（保守策略）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;• 哈希 fail → quarantine（直接短路）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;• 哈希 missing → review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;• 来源未列 (distro_wiki) / 未知 / 伪冒 → review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;• 语义 risk_score ≥ 0.70 → quarantine&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;• 语义 0.40 ≤ risk_score &amp;lt; 0.70 → review&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.3;fontSize=10;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=9;spacingRight=6;" vertex="1" parent="1">
