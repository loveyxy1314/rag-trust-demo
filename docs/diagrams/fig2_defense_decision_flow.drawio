          <mxGeometry x="548" y="660" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="out_block" value="quarantine (≥0.70) 或 review (0.40–0.70)&lt;br&gt;排除出生成上下文，写入审计日志（记入 FPR / 误伤统计）" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
