<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.1 Chrome/142.0.7444.265 Electron/39.8.0 Safari/537.36" version="29.6.1">
  <diagram id="fig4_experiment_evolution_flow" name="图4_五阶段实验演进与决策闭环">
    <mxGraphModel dx="1188" dy="701" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1058" pageHeight="388" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" parent="1" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;阶段 1：正式轮四组对照（768 查询）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 组合防护将 ASR 由 0.650 压至 0.000&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 检测器 P=0.976 / R=1.000 / FPR=0.63%&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 暴露：14 条 distro_wiki 转复核致正确率 −16.7%&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="286" x="20" y="22" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;阶段 2：证据粒度四条件消融（388 条）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 97 开发题对比句子抽取与完整段落&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 原开发 AI 暂判：句子 42/47 vs 段落 67/72&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 结论：完整段落避免撕裂条件，净增 +25 题&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="286" x="386" y="22" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;阶段 3：API 挑战与 GPT-6 复核（224 条）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 8 事实簇 × 7 场景 = 56 题（98 项复核）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 联合口径：段落不滤 27/56 &amp;gt; 过滤 22/56&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 失败：全文过滤误杀 8/8 合法引用样例&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="286" x="752" y="22" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.4;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;阶段 4：语义门控 v1（153 条 · 负面实验）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 133 次 1.5B 调用全部拒答（覆盖率 0%）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 24 次正负/反转编码/自由解码诊断确认&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;  非单纯约束解码问题 → 止损不并入默认&lt;/font&gt;" vertex="1">
          <mxGeometry height="144" width="286" x="20" y="206" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;阶段 5：BGE 重排与句界标记（612 条）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 40 对探针：复述 8/8、错事实 6/8 过高分&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;  → 禁止相关性阈值作充分性/事实门槛&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 44 项补评：API 32/56 (+5/0退)，开发 66/97&lt;/font&gt;" vertex="1">
          <mxGeometry height="144" width="286" x="386" y="206" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.6;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=center;spacingLeft=9;spacingRight=6;" value="&lt;b&gt;最终工程冻结决策&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 默认：三层可审计筛查 + 完整段落&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 优先候选：重排+标记（待做 2×2 因子消融）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 排除：全局禁止词 / 语义门控 v1 / 硬阈值&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px;&quot; color=&quot;#4A5568&quot;&gt;• 后续：新建 ≥24 个未见事实簇验证&lt;/font&gt;" vertex="1">
          <mxGeometry height="144" width="286" x="752" y="206" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343A40;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" target="s2" value="诊断覆盖率">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343A40;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" target="s3" value="压力测试">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" target="s4" value="尝试语义门控">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="895" y="182" />
              <mxPoint x="163" y="182" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 3;" target="s5" value="止损转向重排">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C5282;strokeWidth=1.4;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" target="s6" value="核验冻结">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footnote" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#6C757D;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;" value="注：不同阶段的数据集与裁判口径（规则评分 / 原开发 AI 暂判 / GPT-6 事后联合口径 / 模型辅助溯源补评）严格分开统计，不跨表混算。" vertex="1">
