<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="rag-trust-demo" version="24.7.17">
  <diagram id="fig3_threat_model_scenes" name="图3_威胁模型与场景对照">
    <mxGraphModel dx="1100" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="416" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_atk" value="攻击者能力与投毒载荷" style="rounded=1;arcSize=4;fillColor=#FAFAFB;strokeColor=#ADB5BD;fontColor=#495057;strokeWidth=1.0;fontSize=10.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;verticalAlign=top;align=left;spacingTop=5;spacingLeft=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="18" width="250" height="368" as="geometry" />
        </mxCell>
        <mxCell id="c_post" value="(a) post_ingestion：入库建基线后篡改" style="rounded=1;arcSize=4;fillColor=#FAFAFB;strokeColor=#ADB5BD;fontColor=#495057;strokeWidth=1.0;fontSize=10.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;verticalAlign=top;align=left;spacingTop=5;spacingLeft=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="294" y="18" width="706" height="172" as="geometry" />
        </mxCell>
        <mxCell id="c_pre" value="(b) pre_ingestion：入库前供应链投毒" style="rounded=1;arcSize=4;fillColor=#FAFAFB;strokeColor=#ADB5BD;fontColor=#495057;strokeWidth=1.0;fontSize=10.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;verticalAlign=top;align=left;spacingTop=5;spacingLeft=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="294" y="214" width="706" height="172" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;恒定规模同 ID 替换&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;语料恒为 400 条 (5% / 10% / 20%)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;可伪造声明式 source 字段&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=9;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="36" y="56" width="218" height="78" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;提示注入载荷 (100 条)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;I1：定向改写技术结论&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;I2：诱导输出哨兵 RAG_POISON_999&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=9;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="36" y="152" width="218" height="74" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;错误技术事实 (100 条)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;F1 / F2：颠倒 Linux 系统调用语义&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;无显式指令词，关键词规则难拦截&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=9;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="36" y="244" width="218" height="74" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="约束：不可篡改已落盘基线与评价真值" style="rounded=1;arcSize=6;fillColor=#FFFDFD;strokeColor=#9B2C2C;fontColor=#9B2C2C;strokeWidth=1.2;fontSize=9.8;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="36" y="334" width="218" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1. 干净语料入库&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;400 条正常文档&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#343A40;fontColor=#1A202C;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="314" y="68" width="132" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. 建立基线清单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;记录干净 SHA-256&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#2D3748;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="476" y="68" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. 攻击者替换文档&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;字节改变 (同 doc_id)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.3;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="646" y="68" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. 哈希检出 100%&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;16/16 · 28/28 · 55/55&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;ASR = 0（正确率 83.3%）&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.5;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="816" y="62" width="166" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pn" value="结论：字节级哈希对入库后篡改零漏报且低开销，但无法验证入库前内容真实性。" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#495057;strokeWidth=0;fontSize=9.8;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="314" y="148" width="668" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;1. 投毒文档混入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;含伪造 man_pages&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.3;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="314" y="258" width="132" height="62" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;2. 后建基线清单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;基线含投毒文本&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#2D3748;strokeWidth=1.2;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="476" y="258" width="140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;3. 哈希检出 0%&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;integrity 组退化为&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;baseline (ASR 65%)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FDF2F2;strokeColor=#9B2C2C;fontColor=#742A2A;strokeWidth=1.3;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="646" y="258" width="140" height="62" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;4. 来源 + 语义互补&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;来源 31/55 · 语义 24/55&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#4A5568&quot;&gt;ASR = 0（14 正常转复核）&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EEF3F8;strokeColor=#2C5282;fontColor=#1A365D;strokeWidth=1.5;fontSize=10.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="816" y="252" width="166" height="74" as="geometry" />
        </mxCell>
        <mxCell id="rn" value="结论：入库前投毒必须依赖来源规则与语义检测互补拦截；保守来源白名单带来覆盖率代价。" style="rounded=0;fillColor=none;strokeColor=none;fontColor=#495057;strokeWidth=0;fontSize=9.8;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="314" y="340" width="668" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343A40;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
