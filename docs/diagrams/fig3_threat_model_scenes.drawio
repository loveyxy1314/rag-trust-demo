        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C5282;strokeWidth=1.3;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343A40;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.2;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="联防" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2C5282;strokeWidth=1.3;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.1;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="a2" target="p3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="282" y="189" />
              <mxPoint x="282" y="50" />
              <mxPoint x="716" y="50" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B2C2C;strokeWidth=1.1;endArrow=classic;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica Neue, Arial, sans-serif;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="a3" target="r1">
