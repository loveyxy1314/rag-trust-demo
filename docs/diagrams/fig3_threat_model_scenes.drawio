  <diagram id="fig3_threat_model_scenes" name="图 3  威胁模型与入库前后（Pre vs Post Ingestion）投毒对照流程图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="670" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_main" value="&lt;b&gt;图 3  威胁模型与入库前后（Pre vs Post Ingestion）投毒对照流程图&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=18;fontColor=#1D3557;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="1240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title_sub" value="受控对照实验设计：区分字节级篡改（post）与供应链入库前污染（pre）对三层防护的不同可观测性" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#5A626A;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;" vertex="1" parent="1">
          <mxGeometry x="20" y="42" width="1240" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c_atk" value="攻击者能力边界与投毒载荷" style="rounded=1;arcSize=6;fillColor=#F4F5F7;strokeColor=#6C757D;fontColor=#2D3436;strokeWidth=1.2;fontSize=12;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="28" y="80" width="346" height="528" as="geometry" />
        </mxCell>
        <mxCell id="c_post" value="场景 A：post_ingestion（入库建基线后发生篡改）" style="rounded=1;arcSize=6;fillColor=#EDF6EC;strokeColor=#59A14F;fontColor=#24541E;strokeWidth=1.4;fontSize=12;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="404" y="80" width="848" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c_pre" value="场景 B：pre_ingestion（投毒发生在基线建立之前）" style="rounded=1;arcSize=6;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.4;fontSize=12;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="404" y="358" width="848" height="250" as="geometry" />
        </mxCell>
        <mxCell id="atk_cap" value="攻击假设（恒定语料规模 400）&lt;br&gt;• 替换同 doc_id 正常文档（5%/10%/20%）&lt;br&gt;• 可伪造声明式 source（如 man_pages）&lt;br&gt;• 不可篡改已落盘基线清单与评价真值" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.7;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="48" y="124" width="306" height="114" as="geometry" />
        </mxCell>
        <mxCell id="atk_inj" value="载荷类型 1：提示注入（100 条）&lt;br&gt;• I1 定向改写答案指令&lt;br&gt;• I2 诱导输出哨兵 RAG_POISON_999&lt;br&gt;伪装为技术备注或系统提示" style="rounded=1;arcSize=12;fillColor=#FEF3E6;strokeColor=#F28E2B;fontColor=#7A4100;strokeWidth=1.8;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="48" y="266" width="306" height="110" as="geometry" />
        </mxCell>
        <mxCell id="atk_fact" value="载荷类型 2：错误技术事实（100 条）&lt;br&gt;• F1 / F2 颠倒 Linux 系统调用语义&lt;br&gt;（如 fork 返回值、SIGKILL 可捕获等）&lt;br&gt;无显式攻击指令，规则词难以拦截" style="rounded=1;arcSize=12;fillColor=#FEF3E6;strokeColor=#F28E2B;fontColor=#7A4100;strokeWidth=1.8;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="48" y="404" width="306" height="110" as="geometry" />
        </mxCell>
        <mxCell id="atk_iso" value="安全边界：攻击者无法触达 evaluation_only" style="rounded=1;arcSize=12;fillColor=#FFF7F7;strokeColor=#CC3311;fontColor=#A61C00;strokeWidth=1.8;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="48" y="534" width="306" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="1. 干净语料入库&lt;br&gt;400 条正常文档" style="rounded=1;arcSize=12;fillColor=#EBF2F7;strokeColor=#4E79A7;fontColor=#1F3B57;strokeWidth=1.5;fontSize=11.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="426" y="134" width="168" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="2. 先建 SHA-256 基线&lt;br&gt;记录干净文本摘要" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#EDF6EC;strokeColor=#59A14F;fontColor=#24541E;strokeWidth=1.6;fontSize=11.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="626" y="134" width="178" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="3. 攻击者替换文档&lt;br&gt;文本字节改变&lt;br&gt;（同 doc_id 替换）" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.7;fontSize=11.5;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="836" y="134" width="178" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="4. 完整性校验结果&lt;br&gt;100% 检出篡改&lt;br&gt;16/16 · 28/28 · 55/55&lt;br&gt;ASR = 0（无需语义层）" style="rounded=1;arcSize=12;fillColor=#EDF6EC;strokeColor=#59A14F;fontColor=#24541E;strokeWidth=2.0;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1046" y="124" width="184" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p_note" value="关键结论（post_ingestion）：哈希校验对“入库后字节级篡改”零漏报、低开销；20% 投毒下 integrity 组正确率 83.3%（vs baseline 37.5%）。" style="rounded=1;arcSize=12;fillColor=#EAF5F4;strokeColor=#76B7B2;fontColor=#1F4E4A;strokeWidth=1.2;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="426" y="244" width="804" height="62" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1. 投毒文档混入&lt;br&gt;同 doc_id 替换&lt;br&gt;（含伪造 man_pages）" style="rounded=1;arcSize=12;fillColor=#FDECEC;strokeColor=#E15759;fontColor=#7F1D1D;strokeWidth=1.7;fontSize=11.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="426" y="412" width="168" height="82" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="2. 后建 SHA-256 基线&lt;br&gt;基线已包含投毒文本&lt;br&gt;哈希校验检出率 0%" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FDF9E7;strokeColor=#D4A017;fontColor=#6B4E00;strokeWidth=1.7;fontSize=11.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="626" y="412" width="178" height="82" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="3. 来源 + 语义联防&lt;br&gt;来源拦截 31/55 未知源&lt;br&gt;语义拦截 24/55 伪造源" style="rounded=1;arcSize=12;fillColor=#FEF3E6;strokeColor=#F28E2B;fontColor=#7A4100;strokeWidth=2.2;fontSize=11.2;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="836" y="412" width="178" height="82" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="4. 防护结果与代价&lt;br&gt;ASR(被攻击) 65% → 0%&lt;br&gt;代价：14 条正常&lt;br&gt;distro_wiki 被转复核" style="rounded=1;arcSize=12;fillColor=#EDF6EC;strokeColor=#59A14F;fontColor=#24541E;strokeWidth=1.8;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1046" y="402" width="184" height="104" as="geometry" />
        </mxCell>
        <mxCell id="r_note" value="关键结论（pre_ingestion）：SHA-256 无法发现入库前投毒（integrity 组与 baseline 完全一致，ASR 65%）；必须依赖来源与内容级语义检测互补。" style="rounded=1;arcSize=12;fillColor=#FFF7F7;strokeColor=#CC3311;fontColor=#A61C00;strokeWidth=1.4;fontSize=11;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="426" y="522" width="804" height="62" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4E79A7;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;fontSize=11;fontColor=#2D3436;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="入库后篡改" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E15759;strokeWidth=1.6;endArrow=block;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;fontSize=11;fontColor=#2D3436;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3">
