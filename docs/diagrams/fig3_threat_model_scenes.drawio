        <mxCell id="e6" value="全部隔离" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#59A14F;strokeWidth=1.8;endArrow=block;endFill=1;fontFamily=Microsoft YaHei, PingFang SC, Helvetica, Arial, sans-serif;fontSize=11;fontColor=#2D3436;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="r4">
